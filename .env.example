# Porta local do servidor
PORT=3000

# Mercado Pago - credenciais do painel de desenvolvedor
# Use credenciais de teste primeiro.
MERCADO_PAGO_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADO_PAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opcional: URL pública para webhooks quando publicar o site
# Exemplo: https://sua-loja.com/api/webhooks/mercadopago
MERCADO_PAGO_NOTIFICATION_URL=
